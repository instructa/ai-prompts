{
  "name": "instructa-ai-prompts",
  "version": "1.0.0",
  "description": "Open source AI prompts & rules repository",
  "main": "scripts/build-index.js",
  "scripts": {
    "all-scripts": "pnpm run test:structure && pnpm run build-index",
    "test:structure": "node scripts/validate-structure.js",
    "build-index": "node scripts/build-index.js"
  },
  "dependencies": {
    "zod": "3.24.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.1.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.15.0",
      "onFail": "download"
    }
  }
}
